# Tradier API key — enables real-time options data ($10/mo brokerage account)
# Free sandbox keys work too (sign up at sandbox.tradier.com)
# If not set, falls back to CBOE free delayed data (15-min delay, no key needed)
TRADIER_API_KEY=

# Anthropic API key — powers the AI Co-Pilot chat
# Optional: users can also provide their own key at runtime via the settings panel
ANTHROPIC_API_KEY=
