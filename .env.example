# ── Access tokens (REQUIRED for any server-side API key to be usable) ──
# Secret used to sign/verify JWT access tokens for premium features. At least 32 characters.
# Functions spend a server-side key (Anthropic, Tradier, Finnhub, Alpha Vantage) only for a caller with a
# valid token. If this is unset, validateToken and the server-key paths of askLLM and getModels answer 503;
# the data functions carry on without server keys (CBOE, Yahoo, the caller's own Finnhub key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mint tokens: node scripts/generate-token.js --tier pro --days 365 --label "me"
TOKEN_SECRET=

# ── Cross-origin access (optional) ──
# The dashboard calls its functions same-origin, so this is only needed if another
# origin (a local dev server on a different port, a second site) must call the API.
# Comma-separated list of origins, e.g. http://localhost:5173,https://example.com
SITE_ORIGIN=

# ── Market data ──
# Tradier API key — real-time options data ($10/mo brokerage account). Free sandbox keys work too.
# Used only for access-token holders; anonymous callers get CBOE (15-min delayed, no key needed).
# Users can also paste their own key in Settings (sent as x-tradier-key).
TRADIER_API_KEY=
# Tickers snapshotted nightly into flow_history by collectFlowHistory (comma-separated).
# Default: AVGO,NVDA,AAPL,TSLA,MSFT,META,AMZN,GOOGL,AMD,SPY,QQQ
TRACKED_TICKERS=

# ── AI Co-Pilot ──
# Anthropic API key. Used only for access-token holders, subject to the limits below.
# Users can also provide their own Anthropic / OpenAI / Gemini key at runtime via Settings.
ANTHROPIC_API_KEY=
# Models the shared key may be used with (comma-separated; trailing * matches a prefix). Default: claude-*
ALLOWED_MODELS=claude-*
# Output-token cap per request on the shared key (default 4096). Bring-your-own-key requests are capped at min(model limit, 16384).
MAX_OUTPUT_TOKENS=4096
# Daily request quotas per token (enforced when Supabase is configured). Defaults: 50 / 500
DAILY_REQUEST_QUOTA_TRIAL=50
DAILY_REQUEST_QUOTA_PRO=500
# Time allowed for the upstream LLM to start responding (first byte), in ms; the streamed reply itself is bounded by the platform's function timeout. Default: 60000
LLM_TIMEOUT_MS=60000

# ── Ticker research ──
# Finnhub API key — news, analyst ratings, technicals, fundamentals. Free tier: 60 calls/min.
# Used only for access-token holders; users can paste their own key in Settings (x-finnhub-key).
FINNHUB_API_KEY=
# Alpha Vantage key — earnings (EPS actual/estimate). Free tier: 25 calls/day, cached in Supabase.
# Server-only; access-token holders only.
ALPHA_VANTAGE_KEY=

# ── Supabase (auth, data persistence, flow history, earnings cache, token revocation, quotas) ──
# Create a free project at supabase.com, then run supabase/migrations/001 → 005 in order
# in the SQL editor (see supabase/README.md).
# Server-side (Netlify Functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Client-side (browser) — user data sync (positions, preferences, chat)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Netlify Forms (no env var needed) ──
# "Request Access" submissions are handled by Netlify Forms (free, built-in).
# To receive email notifications when someone requests access:
#   1. Deploy to Netlify
#   2. Go to: Site > Forms > Notifications > Add notification > Email notification
#   3. Select the "access-request" form and enter your email address
# Your email is never stored in code — only in the Netlify dashboard.

# ── Rate limiting ──
# Functions apply a best-effort per-IP limit in memory. For a real limit, enable Netlify's
# built-in rate limiting for /.netlify/functions/* under Site configuration > Access & security.
