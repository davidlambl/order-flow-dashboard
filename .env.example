# Tradier API key — enables real-time options data ($10/mo brokerage account)
# Free sandbox keys work too (sign up at sandbox.tradier.com)
# If not set, falls back to CBOE free delayed data (15-min delay, no key needed)
TRADIER_API_KEY=

# Anthropic API key — powers the AI Co-Pilot chat
# Optional: users can also provide their own key at runtime via the settings panel
ANTHROPIC_API_KEY=

# Finnhub API key — enables news, earnings, analyst ratings, technicals, and fundamentals
# Free tier: 60 calls/min, no daily cap. Sign up at finnhub.io
# Optional: users can also provide their own key at runtime via the settings panel
FINNHUB_API_KEY=

# Secret used to sign/verify JWT access tokens for premium features
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# ── Netlify Forms (no env var needed) ──
# "Request Access" submissions are handled by Netlify Forms (free, built-in).
# To receive email notifications when someone requests access:
#   1. Deploy to Netlify
#   2. Go to: Site > Forms > Notifications > Add notification > Email notification
#   3. Select the "access-request" form and enter your email address
# Your email is never stored in code — only in the Netlify dashboard.
